#!/usr/bin/env bash

# Hyprland binds run with a PATH lacking ~/.local/bin (qs-dmenu lives there)
export PATH="$HOME/.local/bin:$PATH"

menu() {
    local prompt="$1"
    local options="$2"

    echo -e "$options" | qs-dmenu -p "$prompt…"
}

show_background_menu() {
    local choice
    choice=$(find -L "$HOME/Pictures" "$HOME/Dropbox/Wallpapers" -maxdepth 2 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) 2>/dev/null |
        sort | qs-dmenu -i -p "Background…") || return
    "$HOME/.local/bin/set-bg" "$choice"
}

audio() {
    case $(menu "Audio output" "  Headphones\n  Speakers") in
    *Speakers*)
        pactl set-default-sink "alsa_output.pci-0000_01_00.1.hdmi-stereo" &&
            notify-send "Audio switched to speakers"
        ;;
    *Headphones*)
        pactl set-default-sink "alsa_output.pci-0000_10_00.6.analog-stereo" &&
            notify-send "Audio switched to headphones"
        ;;
    esac
}

battery() {
    local devicesList=""
    for item in $(upower --enumerate); do
        info=$(upower --show-info $item)
        model=$(echo "$info" | grep -e 'model')
        percentage=$(echo "$info" | grep -e 'percentage')

        if [[ "$model" == "" ]]; then
            # missing model
            continue
        fi

        if [[ "$percentage" == "" ]]; then
            # missing percentage
            continue
        fi

        # clean up
        model=$(echo "$model" | sed 's/model://' | xargs)
        percentage=$(echo "$percentage" | sed 's/percentage://')
        percentage=$(echo "$percentage" | sed 's/(should be ignored)//' | xargs)

        devicesList="${devicesList}${model}: ${percentage}\n"
    done

    echo -e "$devicesList" | qs-dmenu -p "Battery…"
}

selectednote() {
    local noteFolder="$HOME/Dropbox/Documents/Notes/"

    local curfiles=$(find $noteFolder -type f -printf '%T@ %P\n' | sort -nr | cut -d' ' -f2-)
    local choice=$(
        echo -e "New\n$curfiles" | qs-dmenu -p "Choose note or create new…"
    )

    case $choice in
    New)
        name="$(echo "" | qs-dmenu -t -p "Enter new file name without extension…")" || exit 0
        : "${name:=$(date +%F_%H-%M-%S)}"
        setsid -f "$TERMINAL" -e nvim $noteFolder$name".md" >/dev/null 2>&1
        ;;
    *.md)
        setsid -f "$TERMINAL" -e nvim "$noteFolder$choice" >/dev/null 2>&1
        ;;
    *)
        exit
        ;;
    esac
}

tmuxRepos() {
    # list all projects
    local repoName="$(ls -1d "$HOME"/work/*/ 2>/dev/null | xargs -n1 basename)"

    [ -n "$repoName" ] || exit 0

    local chosen=$(echo -e "$repoName" | qs-dmenu -p 'Projects…')

    [ -n "$chosen" ] || exit 0

    local dir="$HOME/work/$chosen"

    tmux new-window -n "$chosen" -t 0: -c "$dir"

    local tmuxWorkspace=$(hyprctl clients -j | jq -r '.[] | select(.title=="tmux") | .workspace.id')

    hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$tmuxWorkspace\" }))"
}

show_main_menu() {
    case $(menu "Choose" "  Project\n  Audio\n  Keybindings\n󰎚  Notes\n  Background\n󱂩  NwgDock\n  Screenshot\n  Screenrecord\n  Battery\n󰃉  Color") in
    *Project*) tmuxRepos ;;
    *Audio*) audio ;;
    *Background*) show_background_menu ;;
    *Keybindings*) source $HOME/.local/bin/keybindings ;;
    *Notes*) selectednote ;;
    *NwgDock*) pgrep -f nwg-dock-hyprland && pkill -f nwg-dock-hyprland || nwg-dock-hyprland -i 30 -x -c "qs ipc call launcher toggle" ;;
    *Screenshot*) source $HOME/.local/bin/screenshot ;;
    *Screenrecord*) source $HOME/.local/bin/start-stop-screenrecord ;;
    *Battery*) battery ;;
    *Color*)
        hyprpicker
        ;;
    *) exit 0 ;;
    esac
}

show_main_menu
